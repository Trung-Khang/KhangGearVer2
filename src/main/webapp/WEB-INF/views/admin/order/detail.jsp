<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="/WEB-INF/tld/jakarta-tags-core.tld" %><!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Chi tiết đơn hàng | KhangGear</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="container py-4"><a href="${pageContext.request.contextPath}/admin/order/list">← Danh sách đơn hàng</a><div class="card mt-3"><div class="card-body"><h1 class="h3">Đơn hàng #${order.id}</h1><p>${order.receiverName} · ${order.phone} · ${order.email}</p><p>${order.shippingAddress}</p><table class="table"><thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody><c:forEach var="item" items="${order.items}"><tr><td>${item.productName}</td><td>${item.quantity}</td><td>${item.unitPrice}</td><td>${item.lineTotal}</td></tr></c:forEach></tbody></table><p class="fw-bold">Tổng: ${order.totalAmount}</p><form method="post" action="${pageContext.request.contextPath}/admin/order/update-status"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${order.id}"><select class="form-select d-inline w-auto" name="status"><c:forEach var="s" items="${statuses}"><option value="${s}" ${order.orderStatus == s ? 'selected' : ''}>${s}</option></c:forEach></select><button class="btn btn-primary">Cập nhật</button></form></div></div></main></body></html>
