<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="/WEB-INF/tld/jakarta-tags-core.tld" %><!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Quản lý đơn hàng | KhangGear</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="container py-4"><h1 class="h3">Quản lý đơn hàng</h1><c:if test="${not empty message}"><div class="alert alert-success">${message}</div></c:if><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><form class="row g-2 mb-3" method="get"><div class="col-md-5"><input class="form-control" name="keyword" value="${keyword}" placeholder="Mã đơn, khách hàng, email..."></div><div class="col-md-3"><select class="form-select" name="status"><option value="">Mọi trạng thái</option><c:forEach var="s" items="${statuses}"><option value="${s}" ${status == s ? 'selected' : ''}>${s}</option></c:forEach></select></div><div class="col-auto"><button class="btn btn-secondary">Tìm</button></div></form><div class="card"><div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Tổng</th><th>Ngày</th><th>Trạng thái</th><th></th></tr></thead><tbody><c:forEach var="o" items="${orders.content}"><tr><td>#${o.id}</td><td>${o.receiverName}<br>${o.email}</td><td>${o.totalAmount}</td><td>${o.createdAt}</td><td>${o.orderStatus}</td><td><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/admin/order/detail?id=${o.id}">Chi tiết</a></td></tr></c:forEach></tbody></table></div></div></main></body></html>
