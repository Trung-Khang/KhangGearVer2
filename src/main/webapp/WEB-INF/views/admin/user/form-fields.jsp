<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="/WEB-INF/tld/jakarta-tags-core.tld" %>
<div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="username">Username</label><input class="form-control" id="username" name="username" required minlength="3" maxlength="50" pattern="[A-Za-z0-9._-]{3,50}" value="<c:out value='${form.username}'/>"><div class="text-danger small"><c:out value="${fieldErrors.username}"/></div></div><div class="col-md-6 mb-3"><label class="form-label" for="email">Email</label><input class="form-control" id="email" name="email" type="email" required maxlength="254" value="<c:out value='${form.email}'/>"><div class="text-danger small"><c:out value="${fieldErrors.email}"/></div></div></div>
<div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="fullName">Họ tên</label><input class="form-control" id="fullName" name="fullName" maxlength="150" value="<c:out value='${form.fullName}'/>"><div class="text-danger small"><c:out value="${fieldErrors.fullName}"/></div></div><div class="col-md-6 mb-3"><label class="form-label" for="phone">Số điện thoại</label><input class="form-control" id="phone" name="phone" maxlength="20" pattern="[0-9+() .-]{8,20}" value="<c:out value='${form.phone}'/>"><div class="text-danger small"><c:out value="${fieldErrors.phone}"/></div></div></div>
<div class="row"><div class="col-md-4 mb-3"><label class="form-label" for="role">Role</label><select class="form-select" id="role" name="role" required><c:forEach var="item" items="${roles}"><option value="${item}" ${item == form.role ? 'selected' : ''}>${item}</option></c:forEach></select><div class="text-danger small"><c:out value="${fieldErrors.role}"/></div></div><div class="col-md-4 mb-3"><label class="form-label" for="password">Mật khẩu mới</label><input class="form-control" id="password" name="password" type="password" minlength="8" maxlength="100" autocomplete="new-password"><div class="form-text">Bắt buộc khi thêm; để trống khi sửa để giữ nguyên.</div><div class="text-danger small"><c:out value="${fieldErrors.password}"/></div></div><div class="col-md-4 mb-3"><label class="form-label" for="confirmPassword">Xác nhận mật khẩu</label><input class="form-control" id="confirmPassword" name="confirmPassword" type="password" minlength="8" maxlength="100" autocomplete="new-password"><div class="text-danger small"><c:out value="${fieldErrors.confirmPassword}"/></div></div></div>
<div class="form-check form-switch mb-2"><input class="form-check-input" id="active" name="active" type="checkbox" value="true" ${form.active ? 'checked' : ''}><label class="form-check-label" for="active">Tài khoản hoạt động</label></div><div class="form-check form-switch mb-3"><input class="form-check-input" id="emailVerified" name="emailVerified" type="checkbox" value="true" ${form.emailVerified ? 'checked' : ''}><label class="form-check-label" for="emailVerified">Email đã xác minh</label></div>
