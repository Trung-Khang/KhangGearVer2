<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="/WEB-INF/tld/jakarta-tags-core.tld" %>
<!doctype html>
<html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thêm người dùng | KhangGear</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand" href="${pageContext.request.contextPath}/admin">KhangGear Admin</a></div></nav><main class="container py-4"><a href="${pageContext.request.contextPath}/admin/user/list">← Danh sách người dùng</a><div class="card shadow-sm mt-3"><div class="card-body"><h1 class="h3">Thêm người dùng</h1><c:if test="${not empty fieldErrors.form}"><div class="alert alert-danger"><c:out value="${fieldErrors.form}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/admin/user/add"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><jsp:include page="form-fields.jsp"/><button class="btn btn-primary" type="submit">Lưu người dùng</button> <a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/admin/user/list">Hủy</a></form></div></div></main></body></html>
