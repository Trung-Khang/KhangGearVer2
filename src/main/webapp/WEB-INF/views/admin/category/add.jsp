<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thêm danh mục | KhangGear</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand" href="${pageContext.request.contextPath}/admin">KhangGear Admin</a></div></nav><main class="container py-4"><a href="${pageContext.request.contextPath}/admin/category/list">← Danh sách danh mục</a><div class="card shadow-sm mt-3"><div class="card-body"><h1 class="h3">Thêm danh mục</h1><div class="alert alert-danger" ${empty error ? 'hidden' : ''}>${error}</div><form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/admin/category/add"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="mb-3"><label class="form-label" for="name">Tên danh mục</label><input class="form-control" id="name" name="name" value="${category.name}" required maxlength="150"><div class="form-text">Tên không được để trống hoặc trùng.</div></div><div class="mb-3"><label class="form-label" for="description">Mô tả</label><textarea class="form-control" id="description" name="description" maxlength="1000">${category.description}</textarea></div><div class="mb-3"><label class="form-label" for="icon">Icon (PNG, JPG/JPEG, WebP, tối đa 2 MB)</label><input class="form-control" id="icon" name="icon" type="file" accept="image/png,image/jpeg,image/webp"></div><button class="btn btn-primary" type="submit">Lưu danh mục</button> <a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/admin/category/list">Hủy</a></form></div></div></main></body></html>
