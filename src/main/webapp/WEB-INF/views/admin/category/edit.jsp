<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="/WEB-INF/tld/jakarta-tags-core.tld" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sửa danh mục | KhangGear</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand" href="${pageContext.request.contextPath}/admin">KhangGear Admin</a></div></nav><main class="container py-4"><a href="${pageContext.request.contextPath}/admin/category/list">← Danh sách danh mục</a><div class="card shadow-sm mt-3"><div class="card-body"><h1 class="h3">Sửa danh mục</h1><div class="alert alert-danger" ${empty error ? 'hidden' : ''}>${error}</div><form method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/admin/category/edit"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${category.id}"><div class="mb-3"><label class="form-label" for="name">Tên danh mục</label><input class="form-control" id="name" name="name" value="${category.name}" required maxlength="150"></div><div class="mb-3"><label class="form-label" for="description">Mô tả</label><textarea class="form-control" id="description" name="description" maxlength="1000">${category.description}</textarea></div><c:if test="${not empty category.icon}"><p>Icon hiện tại: <img src="${pageContext.request.contextPath}/media/categories/${category.icon}" alt="${category.name}" width="56" height="56"></p></c:if><div class="mb-3"><label class="form-label" for="icon">Icon mới (không chọn sẽ giữ icon cũ)</label><input class="form-control" id="icon" name="icon" type="file" accept="image/png,image/jpeg,image/webp"></div><button class="btn btn-primary" type="submit">Cập nhật</button> <a class="btn btn-outline-secondary" href="${pageContext.request.contextPath}/admin/category/list">Hủy</a></form></div></div></main></body></html>
