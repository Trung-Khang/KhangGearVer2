<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="/WEB-INF/tld/jakarta-tags-core.tld" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Quản lý sản phẩm | KhangGear</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><nav class="navbar navbar-dark bg-primary"><div class="container"><a class="navbar-brand" href="${pageContext.request.contextPath}/admin">KhangGear Admin</a><form method="post" action="${pageContext.request.contextPath}/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-outline-light">Đăng xuất</button></form></div></nav><main class="container py-4"><div class="d-flex justify-content-between mb-3"><h1 class="h3">Quản lý sản phẩm</h1><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/product/add">+ Thêm sản phẩm</a></div><c:if test="${not empty message}"><div class="alert alert-success"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form class="row g-2 mb-3" method="get"><div class="col-md-5"><input class="form-control" name="keyword" value="${keyword}" placeholder="Tìm sản phẩm..."></div><div class="col-md-3"><select class="form-select" name="categoryId"><option value="">Tất cả danh mục</option><c:forEach var="cat" items="${categories.content}"><option value="${cat.id}" ${categoryId == cat.id ? 'selected' : ''}>${cat.name}</option></c:forEach></select></div><div class="col-md-2"><select class="form-select" name="active"><option value="">Mọi trạng thái</option><option value="true" ${active == true ? 'selected' : ''}>Đang bán</option><option value="false" ${active == false ? 'selected' : ''}>Đã khóa</option></select></div><div class="col-auto"><button class="btn btn-secondary">Tìm</button></div></form><div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Ảnh</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:choose><c:when test="${empty products.content}"><tr><td colspan="7" class="text-center py-4">Chưa có sản phẩm.</td></tr></c:when><c:otherwise><c:forEach var="p" items="${products.content}"><tr><td><c:if test="${not empty p.image}"><img src="${pageContext.request.contextPath}/media/products/${p.image}" width="56" height="56" style="object-fit:contain"></c:if></td><td>${p.name}</td><td>${p.category.name}</td><td>${p.price}</td><td>${p.stock}</td><td>${p.active ? 'Đang bán' : 'Đã khóa'}</td><td class="text-nowrap"><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/admin/product/edit?id=${p.id}">Sửa</a> <form class="d-inline" method="post" action="${pageContext.request.contextPath}/admin/product/toggle-status"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${p.id}"><input type="hidden" name="active" value="${not p.active}"><button class="btn btn-sm btn-outline-warning">${p.active ? 'Khóa' : 'Mở bán'}</button></form> <form class="d-inline" method="post" action="${pageContext.request.contextPath}/admin/product/delete"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="id" value="${p.id}"><button class="btn btn-sm btn-outline-danger">Xóa</button></form></td></tr></c:forEach></c:otherwise></c:choose></tbody></table></div></div></main></body></html>
