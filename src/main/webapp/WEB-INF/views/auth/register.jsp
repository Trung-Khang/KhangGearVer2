<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Đăng ký | KhangGear</title></head><body><main><h1>Đăng ký KhangGear</h1><p>${fieldErrors.general}</p><form method="post" action="${pageContext.request.contextPath}/register"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Tên đăng nhập <input name="username" required minlength="3" maxlength="50" value="${form.username}"></label><small>${fieldErrors.username}</small><label>Email <input name="email" type="email" required maxlength="254" value="${form.email}"></label><small>${fieldErrors.email}</small><label>Họ tên <input name="fullName" maxlength="150" value="${form.fullName}"></label><label>Số điện thoại <input name="phone" maxlength="20" value="${form.phone}"></label><small>${fieldErrors.phone}</small><label>Mật khẩu <input name="password" type="password" required minlength="8"></label><small>${fieldErrors.password}</small><label>Xác nhận mật khẩu <input name="confirmPassword" type="password" required minlength="8"></label><small>${fieldErrors.confirmPassword}</small><button type="submit">Đăng ký</button></form><a href="${pageContext.request.contextPath}/login">Đăng nhập</a></main></body></html>
