<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Đặt lại mật khẩu | KhangGear</title></head><body><main><h1>Đặt lại mật khẩu</h1><form method="post" action="${pageContext.request.contextPath}/reset-password"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Mật khẩu mới <input name="password" type="password" required minlength="8"></label><small>${fieldErrors.password}</small><label>Xác nhận mật khẩu <input name="confirmPassword" type="password" required minlength="8"></label><small>${fieldErrors.confirmPassword}</small><button type="submit">Cập nhật mật khẩu</button></form></main></body></html>
