<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Xác minh OTP | KhangGear</title></head><body><main><h1>Xác minh mã đặt lại mật khẩu</h1><p>${message}</p><p>${error}</p><form method="post" action="${pageContext.request.contextPath}/reset-password/verify"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Mã OTP <input name="otp" required pattern="[0-9]{6}" inputmode="numeric" maxlength="6"></label><button type="submit">Xác minh</button></form></main></body></html>
