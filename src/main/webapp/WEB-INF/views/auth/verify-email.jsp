<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html>
<html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Xác minh email | KhangGear</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head>
<body class="bg-light"><main class="container py-5"><div class="card mx-auto shadow-sm" style="max-width:520px"><div class="card-body p-4"><h1 class="h3">Xác minh tài khoản</h1><p class="text-muted">Nhập mã OTP 6 chữ số đã được gửi đến email của bạn.</p><div class="alert alert-danger" ${empty error ? 'hidden' : ''}>${error}</div><div class="alert alert-success" ${empty message ? 'hidden' : ''}>${message}</div>
<form method="post" action="${pageContext.request.contextPath}/verify-email"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label class="form-label" for="otp">Mã OTP</label><input class="form-control" id="otp" name="otp" required pattern="[0-9]{6}" inputmode="numeric" maxlength="6"><div class="text-danger small">${fieldErrors.otp}</div><button class="btn btn-primary mt-3 w-100" type="submit">Xác minh OTP</button></form>
<form method="post" action="${pageContext.request.contextPath}/verify-email/resend" class="mt-2"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-outline-secondary w-100" type="submit">Gửi lại OTP</button></form><a class="d-inline-block mt-3" href="${pageContext.request.contextPath}/login">Quay lại đăng nhập</a>
</div></div></main></body></html>
