<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><title>Xác minh email | KhangGear</title></head><body><main><h1>Xác minh email</h1><p>${message}</p><p>${error}</p><form method="post" action="${pageContext.request.contextPath}/verify-email"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><label>Mã OTP <input name="otp" required pattern="[0-9]{6}" inputmode="numeric" maxlength="6"></label><small>${fieldErrors.otp}</small><button type="submit">Xác minh OTP</button></form><form method="post" action="${pageContext.request.contextPath}/verify-email/resend"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button type="submit">Gửi lại OTP</button></form></main></body></html>
